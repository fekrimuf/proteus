# kenney/survival-kit/tent (llm-recipe, run llm)
# "Tent" is a wooden A-frame: four slanted legs under a ridge beam, with a low and a mid cross bar on each side.
FOOT = 0.26536      # leg foot position (x)
SLANT = 32.59021     # lean of the legs in degrees
LEG_LEN = 0.55756   # length of a leg
Z = 0.23066        # front/back leg position (z)
LEN = 0.56167       # length of the ridge beam and the cross bars
WOOD = 0.03677      # square section of every stick

mid_x = FOOT - sin(radians(SLANT)) * LEG_LEN / 2
mid_y = cos(radians(SLANT)) * LEG_LEN / 2
leg = transform(box(size=[WOOD, LEG_LEN, WOOD]), t=[mid_x, mid_y, Z], r=[0, 0, SLANT])
legs = mirror(mirror(leg, axis="x", offset=0), axis="z", offset=0)
ridge = box(size=[0.05601, 0.03466, LEN], center=[0, 0.40236, 0])
low_bar = box(size=[0.02771, 0.03375, LEN - 0.05884], center=[0.22129, 0.06, 0])
mid_bar = box(size=[0.04822, 0.02034, LEN - 0.0636], center=[0.07798, 0.29225, 0])
bars = mirror(merge(low_bar, mid_bar), axis="x", offset=0)
tent = merge(legs, ridge, bars)
out(tent)
