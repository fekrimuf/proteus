# kenney/furniture-kit/table (llm-recipe, run llm)
# Table with an H-frame: top plate, four legs (mirrored twice), one stretcher.
top = box(size=[0.845, 0.057, 0.447], center=[0.4225, 0.2985, -0.2235])
leg = box(size=[0.065, 0.27, 0.05], center=[0.0325, 0.135, -0.025])
legs_x = mirror(leg, axis="x", offset=0.4225)
legs = mirror(legs_x, axis="z", offset=-0.2235)
stretcher = box(size=[0.78, 0.05, 0.05], center=[0.4225, 0.075, -0.225])
table = merge(top, legs, stretcher)
out(table)
