# kenney/furniture-kit/trashcan: a six-sided bin with a domed, chamfered lid, a pedal at the foot and a handle bar at the lid
# (repair: the first fit had a flat top)
H = 0.40             # height to the top of the lid
R = 0.105            # body radius
LID_H = 0.07         # height of the domed lid
LID_R = 0.065        # radius at the very top of the lid
PEDAL = 0.075        # pedal length, sticking out of the front
BAR = 0.083          # handle bar width

body = transform(tube(cols=6, height=H - LID_H, radius=R, radius_top=R * 0.96), t=[0, (H - LID_H) / 2, 0])
lid = transform(tube(cols=6, height=LID_H, radius=R * 0.96, radius_top=LID_R), t=[0, H - LID_H / 2, 0])
pedal = box(size=[0.03, 0.018, PEDAL], center=[0, 0.03, R + PEDAL / 2 - 0.02])
handle = box(size=[BAR, 0.018, 0.012], center=[0, 0.357, -0.096])
bin = merge(body, lid, pedal, handle)
out(bin)
