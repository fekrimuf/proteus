# Long ladder: two side rails and five rungs (one array).
H = 1.99957          # height
RAIL_W = 0.10257    # rail width (x)
GAP = 0.29849        # clear width between the rails
RUNGS = 4.48829
SPACING = 0.33615

rail = box(size=[RAIL_W, H, 0.09717], center=[GAP / 2 + RAIL_W / 2, H / 2, 0])
rails = mirror(rail, axis="x", offset=0)
rungs = array(box(size=[GAP + -0.04064, 0.06809, 0.06802], center=[0, 0.12192, 0]), count=RUNGS, offset=[0, SPACING, 0])
ladder = merge(rails, rungs)
out(ladder)
