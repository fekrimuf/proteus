# Tall cactus: an eight-sided trunk with a right arm, a left arm and a short front arm (each arm = a stub plus a rise).
TRUNK_R = 0.1
TRUNK_H = 0.75

trunk = tube(radius=TRUNK_R, height=TRUNK_H, cols=8, center=[0.005, 0.325, 0.0])
right_stub = box(size=[0.12, 0.08, 0.09], center=[0.14, 0.14, -0.09])
right_rise = box(size=[0.08, 0.4, 0.09], center=[0.16, 0.29, -0.09])
left_stub = box(size=[0.12, 0.08, 0.09], center=[-0.14, 0.385, -0.095])
left_rise = box(size=[0.08, 0.32, 0.09], center=[-0.16, 0.48, -0.095])
front_rise = box(size=[0.07, 0.37, 0.06], center=[0.0, 0.385, 0.18])
cactus = merge(merge(trunk, right_stub, right_rise), left_stub, left_rise, front_rise)
out(cactus)
