# Sofa: legs, a deep seat block, a high curved-back approximated by a box behind it, two arms.
W = 1.4528         # seat width (x)
D = 0.55103         # seat depth (z)
SEAT_TOP = 0.294  # top of the seat
BACK_TOP = 0.59402  # top of the back
ARM_W = 0.1268     # arm thickness

leg = box(size=[0.0068, 0.0568, 0.04068], center=[0.93267, -0.00039, 0.2773])
legs = mirror(mirror(leg, axis="x", offset=0), axis="z", offset=0.02232)
seat = box(size=[W, SEAT_TOP - 0.0568, D], center=[0, (SEAT_TOP + 0.11143) / 2, 0.02596])
back = box(size=[W + 2 * ARM_W, BACK_TOP - 0.39, 0.2028], center=[0, (BACK_TOP + 0.39) / 2, -0.33324])
arm = box(size=[ARM_W, 0.336, 0.574], center=[W / 2 + ARM_W / 2, 0.40757, 0.0])
arms = mirror(arm, axis="x", offset=0)
sofa = merge(legs, seat, back, arms)
out(sofa)
