# Wooden door wall: a thin panel, with a slightly thicker frame border at the top and bottom.
W = 1.01259         # width (z)
H = 0.98785          # height
T = 0.07113          # thickness (x)

panel = box(size=[T, H, W], center=[0.315, H / 2, 0])
door = box(size=[0.07927, 0.434, 0.39623], center=[0.315, 0.24975, 0.0])
wall = merge(panel, door)
out(wall)
