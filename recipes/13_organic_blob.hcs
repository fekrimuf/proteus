# Organic blob cluster (metaball look).
# Technique: spheres placed on a golden-angle spiral (no two alike, no visible pattern) are
# merged with smooth unions so they melt together, then the SDF is roughened with fractal
# noise and meshed with smooth normals. The loop is plain Python: 7 spheres, 7 combines.
field = sdf_shape(shape="sphere", radius=0.55, center=[0, 0.55, 0], voxel=0.05, padding=0.3)
for i in range(1, 8):
    a = radians(i * 137.508)
    ring = 0.32 + 0.07 * i
    blob = sdf_shape(shape="sphere", radius=0.42 - 0.03 * i, center=[ring * cos(a), 0.45 + 0.13 * i, ring * sin(a)], voxel=0.05, padding=0.3)
    field = sdf_combine(field, blob, op="smooth_union", k=0.22)
rough = sdf_smooth(sdf_displace(field, amp=0.035, freq=4.0, octaves=3, seed=5), iterations=1)
blob = center(sdf_to_mesh(rough), mode="ground")

spec(blob, "height", min=1.0, max=2.6)
spec(blob, "grounded")
spec(blob, "watertight")
spec(blob, "attribute", name="N")
spec(blob, "finite")
out(blob)
