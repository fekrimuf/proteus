# A grove of conifers grown from knobs.
# Technique: `tree_conifer` makes a tree from proportions (height, crown width, droop and lift of the branches, spacing of the whorls) and a
# seed; three knob sets are three species (a narrow fir, a full spruce, a wide pine), and `copy_variants` on stable points
# (`scatter_stable`) mixes them, so no tree repeats and no tree is a scan. A style moves the knobs: `knob("crown_width", 0.28)` would let a
# world file make the whole grove narrower. Needle cards use the library material `conifer_needles` (a picture drawn by `pt gen-texture`).
hill = wrangle(grid(size=[60, 60], rows=60, cols=60), code="""
@P.y = 4.0 * exp(-(@P.x * @P.x + @P.z * @P.z) / 400.0) + 0.5 * sin(@P.x * 0.3) * cos(@P.z * 0.27);
@Cd = mix(vec3(0.28, 0.42, 0.18), vec3(0.5, 0.45, 0.35), smoothstep(0.0, 4.0, @P.y));
""")
ground = normals(hill)

fir = tree_conifer(height=24.0, crown_width=0.22, droop=34.0, lift=16.0, crown_power=0.9, whorl_spacing=0.5, detail=0.7, seed=101)
spruce = tree_conifer(height=20.0, crown_width=0.30, droop=28.0, lift=20.0, crown_power=0.8, whorl_spacing=0.45, detail=0.7, seed=102)
pine = tree_conifer(height=16.0, crown_width=0.40, droop=8.0, lift=34.0, crown_power=0.55, whorl_spacing=0.5, detail=0.7, seed=103)

at = scatter_stable(ground, min_dist=6.5, seed=21, density=0.85, pscale_min=0.75, pscale_max=1.3)
dry = group_by_expression(at, name="dry", expression="@P.y > 0.3")
kept = blast(dry, group="dry", keep_selected=1)
grove = copy_variants(kept, fir, spruce, pine, weights=[1.0, 1.0, 1.0], rot_y_random=360.0, orient_to_normal=0, seed=7)

scene = merge(ground, grove)
spec(scene, "width", min=59.0, max=80.0)
spec(scene, "instances", min=20)
spec(scene, "attribute", name="Cd")
spec(scene, "finite")
out(scene)
