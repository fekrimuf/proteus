# Canyon cut through a plateau.
# Technique: noise gives a rough plateau, then ONE wrangle carves a meandering channel: the
# channel centerline is a sine of x, the cut depth is a smoothstep of the distance to that
# line, and color follows height in sedimentary bands (stairs of fract) so walls look layered.
base = grid(size=[100, 60], rows=140, cols=240)
plateau = noise(base, amp=1.2, freq=0.05, octaves=4, seed=21)
canyon = wrangle(plateau, code="""
float center = ch("wander") * sin(@P.x * 0.07) + 3.0 * sin(@P.x * 0.19);
float d = abs(@P.z - center);
float wall = smoothstep(ch("width") * 0.5, ch("width"), d);
float rough = fbm(@P * 0.3, 4.0) * 1.5;
@P.y = @P.y * wall + (10.0 + rough) * wall - 2.0 * (1.0 - wall) + rough * 0.3 * (1.0 - wall);
""", channels={"wander": 8.0, "width": 12.0})
smoothed = smooth(canyon, iterations=2, strength=0.35, pin_boundary=1)
strata = wrangle(smoothed, code="""
float band = fract(@P.y * 0.55);
float t = fit(@P.y, -2.0, 12.0, 0.0, 1.0);
vec3 rock = mix(vec3(0.55, 0.28, 0.16), vec3(0.85, 0.55, 0.32), band);
@Cd = mix(vec3(0.35, 0.3, 0.22), rock, smoothstep(0.1, 0.5, t));
""")
canyon_geo = normals(strata)

spec(canyon_geo, "width", min=99.0, max=101.0)
spec(canyon_geo, "height", min=8.0, max=20.0)
spec(canyon_geo, "attribute", name="Cd")
spec(canyon_geo, "finite")
out(canyon_geo)
